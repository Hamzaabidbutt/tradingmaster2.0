# Add these values in Vercel: Project → Settings → Environment Variables.
# Do not upload this file or commit real credentials.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tradingmaster?retryWrites=true&w=majority&appName=Cluster0"
AUTH_SECRET="generate-a-unique-48-byte-secret"
BINANCE_FAPI_BASE="https://fapi.binance.com"
BINANCE_WS_BASE="wss://fstream.binance.com"
SIGNAL_MIN_CONFIDENCE="65"
CONFLUENCE_MIN_CONFIDENCE="70"
SCAN_TIMEFRAME="1h"
SCAN_SLICE="40"

# The perpetual scanner/evaluator (`npm run worker`) does not run on Vercel.
# Run it in a separate long-lived worker deployment when live persisted signals
# and target updates are required.
